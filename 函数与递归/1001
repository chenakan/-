long long total = 0;

    for (long long place = 1; place <= n; )
    {
        long long high = n / place / 10;
        long long digit = n / place % 10;
        long long low = n % place;

        total += high * place;

        if (digit > 2)
        {
            total += place;
        }
        else if (digit == 2)
        {
            total += low + 1;
        }

        if (place > n / 10)
            break;

        place *= 10;
    }

    return total;
}

int main(void)
{
    long long L, R;
    scanf("%lld %lld", &L, &R);

    printf("%lld\n", count2(R) - count2(L - 1));

    return 0;
}
