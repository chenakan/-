#include <stdio.h>

int main(void)
{
    int x, y;
    scanf("%d %d", &x, &y);

    if (x > y)
    {
        int temp = x;
        x = y;
        y = temp;
    }

    int count = 0;

    for (int i = x; i <= y; i++)
    {
        int temp = i;
        int sum = 0;

        while (temp > 0)
        {
            sum += temp % 10;
            temp /= 10;
        }

        if (sum % 5 == 0)
        {
            count++;
        }
    }

    printf("%d\n", count);
    return 0;
}
