#include <stdio.h>

int main(void)
{
    int y, m, x;
    int days[] = {0, 31, 28, 31, 30, 31, 30,
                  31, 31, 30, 31, 30, 31};

    while (scanf("%d %d %d", &y, &m, &x) == 3)
    {
        int total = days[m];
        int count = 0;

        if (m == 2 && (y % 400 == 0 ||
                     (y % 4 == 0 && y % 100 != 0)))
        {
            total = 29;
        }

        for (int d = 1; d <= total; d++)
        {
            char date[20];
            sprintf(date, "%04d-%02d-%02d", y, m, d);

            for (int i = 0; date[i] != '\0'; i++)
            {
                if (date[i] == '0' + x)
                {
                    count++;
                }
            }
        }

        printf("%d\n", count);
    }

    return 0;
}
