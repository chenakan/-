include <stdio.h>
#include <stdlib.h>

int compare(const void *p, const void *q)
{
    int x = *(const int *)p;
    int y = *(const int *)q;
    return (x > y) - (x < y);
}

int main(void)
{
    int n;
    int a[100];

    scanf("%d", &n);

    for (int i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    qsort(a, n, sizeof(a[0]), compare);

    for (int i = 0; i + 2 < n; i++)
    {
        if ((long long)a[i] + a[i + 1] > a[i + 2])
        {
            printf("%d %d %d\n", a[i], a[i + 1], a[i + 2]);
            return 0;
        }
    }

    printf("No solution\n");
    return 0;
}
