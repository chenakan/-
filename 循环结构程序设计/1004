#include<stdio.h>
int main()
{
    int T,n,p;
    scanf("%d",&T);
    
    for(int t=0;t<T;t++)
    {
        scanf("%d",&n);
        p=(n+1)/2;
        for(int i=1;i<=p;i++)
        {
            for(int j=1;j<=p-i;j++)
            {
                printf(" ");
            }
            for(int k=1;k<=2*i-1;k++)
            {
                printf("*");
            }
            printf("\n");
        }
        for(int i=p-1;i>=1;i--)
        {
            for(int j=1;j<=p-i;j++)
            {
                printf(" ");
            }
            for(int k=1;k<=2*i-1;k++)
            {
                printf("*");
            }
            printf("\n");
        }
    }
    return 0;
}
