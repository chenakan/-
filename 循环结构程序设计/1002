#include<stdio.h>
int main()
{
    int n;
    while(scanf("%d",&n)!=EOF)
    {   
        int num=1;
        for(int i=1;i<=n;i++)
        {
            for(int j=1;j<=i;j++)
            {
                printf("%4d",num);
                num++;
            }
            printf("\n");
        }
    }
    return 0;
}
