#include<stdio.h>
int main()
{
    int n,t;
   
    while(scanf("%d",&n)!=EOF)
    {
        t=n+1;
        for(int i=1;i<=t;i++)
        {
            for(int j=1;j<=2*(t-i);j++)
            {
                printf(" ");
            }
            for(int k=1;k<=i;k++)
            {
                 printf("*");
            }
            printf("\n");
        }
        for(int i=t-1;i>=1;i--)
        {
            for(int j=1;j<=2*(t-i);j++)
            {
                printf(" ");
            }
            for(int k=1;k<=i;k++)
            {
                printf("*");
            }
            printf("\n");
        }
    }
    return 0;
}
