#include<stdio.h>
int a[10000];
int main()
{
    int L,M,l,r;
    int num=0;
    scanf("%d %d",&L,&M);
   
    for(int i=0;i<=L;i++)
    {
        a[i]=1;
    }
    for(int m=0;m<M;m++)
    {
        scanf("%d %d",&l,&r);
        for(int i=l;i<=r;i++)
        {
            a[i]=0;
        }
    }
    
    for(int i=0;i<=L;i++)
    {
        if(a[i]==1)
        {
            num++;
        }
    }
    printf("%d\n",num);
    return 0;
    
}
