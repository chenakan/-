#include<stdio.h>
int a[1000000];
int main()
{
    int up,input;
    scanf("%d %d",&up,&input);
    int count=0;
    for(int i=0;i<up;i++)
    {
        a[i]=i+1;
    
        int temp=a[i];
        while (temp>0)
        {
            if(temp%10==input)
            {
                 count++;
            }
            temp=temp/10;
        }
    }
    printf("%d",count);
    return 0;
    
        
}
