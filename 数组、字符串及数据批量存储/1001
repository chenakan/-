#include<stdio.h>
int main()
{
    int T,n;
    scanf("%d",&T);
    int a[100000];
    for(int t=0;t<T;t++)
    {
        scanf("%d",&n);
        
            for(int i=0;i<n;i++)
            {
                scanf("%d",&a[i]);
            }
            int max=a[0];
            int min=a[0];
            
            for(int i=1;i<n;i++)
            {
                if(max<a[i])
                {
                    max=a[i];
                }
                if(min>a[i])
                {
                    min=a[i];
                }
                
            }
            int jicha;
            jicha=max-min;
           
            long long sum=0;
            double average=0;
            double varience=0;
            double tt;
            for(int i=0;i<n;i++)
            {
                sum=sum+a[i];
            }
            average=(double)sum/n;
            for(int i=0;i<n;i++)
            {
                tt=a[i]-average;
                varience=varience+tt*tt;
            }
            varience=varience/n;
        
            printf("%d %.3f\n",jicha,varience);
        
    }
    return 0;
}
